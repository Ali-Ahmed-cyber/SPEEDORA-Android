    <string name="discovery_title">Nearby Device Discovery</string>
    <string name="discovery_manual_ip">Manual IP &amp; Port Connection</string>
    <string name="discovery_bluetooth_note">Note: Bluetooth fallback is intended for pairing assistance and small files only; throughput is substantially lower than Wi-Fi Direct or LAN.</string>
    <string name="discovery_no_devices">No nearby devices found yet. Open Receive on the target phone or pair using QR code.</string>
    <string name="sas_verify_title">Mutual Security Verification (SAS)</string>
    <string name="sas_verify_desc">Confirm the 6-digit code matches on both devices before approving the encrypted session (ECDH P-256 + AES-256-GCM):</string>

