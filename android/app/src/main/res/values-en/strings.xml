    <!-- Permissions -->
    <string name="perm_media_title">Media Access Permission</string>
    <string name="perm_media_desc">SPEEDORA needs read access to photos, video, or audio to display your real files for transfer. Nothing is uploaded to any server.</string>
    <string name="perm_nearby_title">Nearby Wireless Discovery Permission</string>
    <string name="perm_nearby_desc">Required to discover nearby devices over Wi-Fi Direct or local Wi-Fi without internet access.</string>
    <string name="perm_camera_title">Camera Permission for QR Pairing</string>
    <string name="perm_camera_desc">Used solely to scan temporary session pairing QR codes; no images are stored.</string>
    <string name="perm_contacts_title">Contacts Permission for Phone Migration</string>
    <string name="perm_contacts_desc">Strictly optional: requested only if you choose to migrate contacts as a vCard file.</string>
    <string name="perm_saf_prompt">To browse documents and folders safely without broad storage permissions, pick a directory using the Android system picker.</string>

