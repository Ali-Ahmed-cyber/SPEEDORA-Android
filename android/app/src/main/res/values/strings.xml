    <!-- Migration -->
    <string name="migration_restriction_note">وفق قيود أمان أندرويد، ينقل SPEEDORA الصور والفيديو والصوتيات والمستندات والتنزيلات المحددة وجهات الاتصال (بموافقتك). لا يمكن استنساخ البيانات الخاصة المحمية للتطبيقات الأخرى بدون صلاحيات النظام.</string>

