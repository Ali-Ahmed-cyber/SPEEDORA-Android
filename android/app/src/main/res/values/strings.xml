    <!-- Permissions (Arabic clear explanations) -->
    <string name="perm_media_title">إذن الوصول إلى الوسائط</string>
    <string name="perm_media_desc">يحتاج SPEEDORA إلى إذن قراءة الصور أو الفيديو أو الصوتيات لعرض ملفات جهازك الحقيقية وإرسالها. لن يتم جمع أو رفع أي ملف إلى الإنترنت.</string>
    <string name="perm_nearby_title">إذن اكتشاف الأجهزة اللاسلكية القريبة</string>
    <string name="perm_nearby_desc">مطلوب لاكتشاف الأجهزة القريبة عبر Wi-Fi Direct أو الشبكة المحلية دون استخدام الإنترنت.</string>
    <string name="perm_camera_title">إذن الكاميرا لمسح رمز QR</string>
    <string name="perm_camera_desc">تُستخدم الكاميرا فقط لقراءة رمز الاقتران المؤقت بين الجهازين ولا يتم تسجيل أو حفظ أي صور.</string>
    <string name="perm_contacts_title">إذن جهات الاتصال لنقل الهاتف</string>
    <string name="perm_contacts_desc">اختياري تماماً: يُطلب فقط عند اختيارك نقل جهات الاتصال كملف vCard إلى جهازك الجديد.</string>
    <string name="perm_saf_prompt">لتصفح المستندات والمجلدات المخصصة بأمان دون صلاحيات نظام حساسة، اختر مجلداً عبر منتقي النظام.</string>

    <!-- Discovery & Pairing -->
    <string name="discovery_title">اكتشاف الأجهزة القريبة</string>
    <string name="discovery_manual_ip">اتصال يدوي عبر IP والمنفذ</string>
    <string name="discovery_bluetooth_note">ملاحظة: وضع البلوتوث مخصص للمساعدة في الاقتران والملفات الصغيرة فقط، وسرعته أقل بكثير من Wi-Fi Direct والشبكة المحلية.</string>
    <string name="discovery_no_devices">لم يتم العثور على أجهزة قريبة حتى الآن. تأكد من فتح صفحة الاستلام على الجهاز الآخر أو استخدم رمز QR.</string>
    <string name="sas_verify_title">التحقق الأمني المتبادل (SAS)</string>
    <string name="sas_verify_desc">تأكد من تطابق رمز التحقق المكون من 6 أرقام على الجهازين قبل الموافقة على الجلسة المشفرة (ECDH P-256 + AES-256-GCM):</string>

